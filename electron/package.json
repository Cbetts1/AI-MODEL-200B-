{
  "name": "aura-desktop",
  "version": "0.5.0",
  "description": "AURA — AI Unified Reasoning Architecture — Desktop App",
  "main": "main.js",
  "author": "Christopher Betts",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Cbetts1/AI-MODEL-200B-",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.aura.ai.desktop",
    "productName": "AURA",
    "copyright": "Copyright © 2024 Christopher Betts",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "icons/**"
    ],
    "win": {
      "target": [
        { "target": "appx", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "icons/aura-256.ico"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "mas", "arch": ["arm64", "x64"] }
      ],
      "icon": "icons/aura-256.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "snap", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "icons/aura-256.png",
      "category": "Utility"
    },
    "appx": {
      "applicationId": "AuraAI",
      "publisher": "CN=Christopher Betts",
      "publisherDisplayName": "Christopher Betts",
      "identityName": "AuraAI"
    }
  }
}
